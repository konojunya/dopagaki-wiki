{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.0.1"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "research": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "concept",
            "repository"
          ]
        },
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "dirtyDiffHash": {
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "accessed": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "official",
              "implementation",
              "spec",
              "test",
              "inference"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "lines": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            ]
          },
          "executed": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "title",
          "url",
          "accessed",
          "kind",
          "note"
        ],
        "additionalProperties": false
      }
    },
    "objectives": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "slides": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            }
          }
        },
        "required": [
          "id",
          "question",
          "slides"
        ],
        "additionalProperties": false
      }
    },
    "voice": {
      "type": "object",
      "properties": {
        "speaker": {
          "default": "ずんだもん",
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "style": {
          "default": "ノーマル",
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "speed": {
          "default": 1.08,
          "type": "number",
          "minimum": 0.8,
          "maximum": 1.4
        },
        "dictionary": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      },
      "additionalProperties": false
    },
    "theme": {
      "default": "accessible-light-v1",
      "type": "string",
      "const": "accessible-light-v1"
    },
    "slides": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "claim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "evidence": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            }
          },
          "content": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "layout": {
                    "type": "string",
                    "const": "title"
                  },
                  "topics": {
                    "minItems": 1,
                    "maxItems": 3,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    }
                  }
                },
                "required": [
                  "layout",
                  "topics"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "layout": {
                    "type": "string",
                    "const": "before-after"
                  },
                  "before": {
                    "type": "object",
                    "properties": {
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      },
                      "detail": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      }
                    },
                    "required": [
                      "label",
                      "detail"
                    ],
                    "additionalProperties": false
                  },
                  "after": {
                    "type": "object",
                    "properties": {
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      },
                      "detail": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      }
                    },
                    "required": [
                      "label",
                      "detail"
                    ],
                    "additionalProperties": false
                  },
                  "takeaway": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                },
                "required": [
                  "layout",
                  "before",
                  "after",
                  "takeaway"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "layout": {
                    "type": "string",
                    "const": "sequence"
                  },
                  "actors": {
                    "minItems": 2,
                    "maxItems": 3,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9-]{0,63}$"
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 300
                        }
                      },
                      "required": [
                        "id",
                        "label"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "messages": {
                    "minItems": 1,
                    "maxItems": 3,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "from": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9-]{0,63}$"
                        },
                        "to": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9-]{0,63}$"
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 300
                        }
                      },
                      "required": [
                        "from",
                        "to",
                        "label"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "activeMessage": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3
                  },
                  "takeaway": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                },
                "required": [
                  "layout",
                  "actors",
                  "messages",
                  "takeaway"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "layout": {
                    "type": "string",
                    "const": "branch"
                  },
                  "condition": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "yes": {
                    "type": "object",
                    "properties": {
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      },
                      "detail": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      }
                    },
                    "required": [
                      "label",
                      "detail"
                    ],
                    "additionalProperties": false
                  },
                  "no": {
                    "type": "object",
                    "properties": {
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      },
                      "detail": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      }
                    },
                    "required": [
                      "label",
                      "detail"
                    ],
                    "additionalProperties": false
                  },
                  "takeaway": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                },
                "required": [
                  "layout",
                  "condition",
                  "yes",
                  "no",
                  "takeaway"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "layout": {
                    "type": "string",
                    "const": "focus"
                  },
                  "parts": {
                    "minItems": 2,
                    "maxItems": 3,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9-]{0,63}$"
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 300
                        }
                      },
                      "required": [
                        "id",
                        "label"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "selected": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,63}$"
                  },
                  "detail": {
                    "type": "object",
                    "properties": {
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      },
                      "detail": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      }
                    },
                    "required": [
                      "label",
                      "detail"
                    ],
                    "additionalProperties": false
                  },
                  "takeaway": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                },
                "required": [
                  "layout",
                  "parts",
                  "selected",
                  "detail",
                  "takeaway"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "layout": {
                    "type": "string",
                    "const": "key"
                  },
                  "headline": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "points": {
                    "minItems": 1,
                    "maxItems": 3,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 300
                        },
                        "detail": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 300
                        }
                      },
                      "required": [
                        "label",
                        "detail"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "layout",
                  "headline",
                  "points"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "layout": {
                    "type": "string",
                    "const": "compare"
                  },
                  "columns": {
                    "minItems": 2,
                    "maxItems": 3,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    }
                  },
                  "rows": {
                    "minItems": 1,
                    "maxItems": 4,
                    "type": "array",
                    "items": {
                      "minItems": 2,
                      "maxItems": 3,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      }
                    }
                  },
                  "takeaway": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                },
                "required": [
                  "layout",
                  "columns",
                  "rows",
                  "takeaway"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "layout": {
                    "type": "string",
                    "const": "flow"
                  },
                  "steps": {
                    "minItems": 2,
                    "maxItems": 3,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 300
                        },
                        "detail": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 300
                        }
                      },
                      "required": [
                        "label",
                        "detail"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "activeStep": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3
                  },
                  "takeaway": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                },
                "required": [
                  "layout",
                  "steps",
                  "takeaway"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "layout": {
                    "type": "string",
                    "const": "code"
                  },
                  "language": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_+-]{1,32}$"
                  },
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 600
                  },
                  "explanation": {
                    "minItems": 1,
                    "maxItems": 3,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    }
                  },
                  "takeaway": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                },
                "required": [
                  "layout",
                  "code",
                  "explanation",
                  "takeaway"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "layout": {
                    "type": "string",
                    "const": "visual"
                  },
                  "asset": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      },
                      "alt": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      },
                      "origin": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "type": "string",
                                "const": "download"
                              },
                              "url": {
                                "type": "string",
                                "format": "uri"
                              }
                            },
                            "required": [
                              "kind",
                              "url"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "type": "string",
                                "const": "generated"
                              },
                              "prompt": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 2000
                              }
                            },
                            "required": [
                              "kind",
                              "prompt"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "type": "string",
                                "const": "diagram"
                              },
                              "description": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 300
                              }
                            },
                            "required": [
                              "kind",
                              "description"
                            ],
                            "additionalProperties": false
                          }
                        ]
                      }
                    },
                    "required": [
                      "path",
                      "alt",
                      "origin"
                    ],
                    "additionalProperties": false
                  },
                  "explanation": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                },
                "required": [
                  "layout",
                  "asset",
                  "explanation"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "layout": {
                    "type": "string",
                    "const": "example"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "cells": {
                    "minItems": 1,
                    "maxItems": 8,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    }
                  },
                  "equation": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "explanation": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                },
                "required": [
                  "layout",
                  "label",
                  "cells",
                  "equation",
                  "explanation"
                ],
                "additionalProperties": false
              }
            ]
          },
          "narration": {
            "minItems": 1,
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 150
                }
              },
              "required": [
                "id",
                "text"
              ],
              "additionalProperties": false
            }
          },
          "gapBefore": {
            "default": 1,
            "type": "number",
            "minimum": 0.3,
            "maximum": 3
          },
          "gapAfter": {
            "default": 1,
            "type": "number",
            "minimum": 0.3,
            "maximum": 3
          }
        },
        "required": [
          "id",
          "title",
          "claim",
          "evidence",
          "content",
          "narration"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "title",
    "question",
    "audience",
    "research",
    "sources",
    "objectives",
    "voice",
    "slides"
  ],
  "additionalProperties": false
}
